[Unit]
Description=Nexus hardware monitoring and control service
# Root system daemon (like coolercontrol's coolercontrold) for full hardware
# access: motherboard pwm, NVML GPU fans, kernel modules, raw i2c/hidraw — no
# udev rules or group juggling needed. It adopts the active user's session at
# startup (see LinuxSession) so the tray, MPRIS media, volume, and dashboard
# keep working. Ordered after graphical.target so a session exists to adopt;
# the HTTP service + hardware run regardless.
After=graphical.target network.target
Wants=graphical.target

[Service]
Type=simple
# Absolute path: a system service can't exec from a user home under SELinux
# (user_home_t); install.sh lands the app in /opt/nexus (bin_t).
ExecStart=/opt/nexus/Nexus
Restart=on-failure
RestartSec=3
# Runs as root (default for a system unit) — that is the point.

[Install]
WantedBy=multi-user.target
