#!/usr/bin/env bash
#
# Pre-push: gate every push on a green test suite.
#
# Default `dotnet test` runs ~541 unit/integration tests in ~1s, thanks to
# tests/Qos.Service.Tests/qos.runsettings which excludes [Trait("Category",
# "Manual")] benchmark runs. Bypass with `git push --no-verify` when
# intentional (e.g. pushing a branch that's known-broken for review).
#
# Install (once per clone):
#   git config core.hooksPath hooks

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
DOTNET="${DOTNET:-$HOME/.dotnet/dotnet}"

if ! command -v "$DOTNET" >/dev/null 2>&1 && [ ! -x "$DOTNET" ]; then
    echo "pre-push: dotnet not found at $DOTNET; set \$DOTNET or skip with --no-verify" >&2
    exit 1
fi

echo "pre-push: running qos-service tests (fast suite; excludes Category=Manual)"
if ! "$DOTNET" test "$REPO_ROOT/Qos.Service.csproj" --nologo -p:BuildWeb=false; then
    echo
    echo "pre-push: tests failed. Push aborted." >&2
    echo "  - Fix the failing tests, OR" >&2
    echo "  - Push with --no-verify if this is intentional" >&2
    exit 1
fi
